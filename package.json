{
  "name": "thamarai-hospital-website",
  "version": "1.0.0",
  "private": true,
  "description": "Thamarai Multispeciality Hospital — public website",
  "scripts": {
    "assemble": "node build/assemble.mjs",
    "css": "tailwindcss -i site/assets/css/input.css -o site/assets/css/app.css --minify",
    "build": "npm run assemble && npm run css",
    "watch:css": "tailwindcss -i site/assets/css/input.css -o site/assets/css/app.css --watch",
    "serve": "node build/serve.mjs"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "node-html-parser": "^6.1.13",
    "tailwindcss": "^3.4.17"
  }
}
